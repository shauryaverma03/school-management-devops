#!/bin/bash
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y curl ca-certificates unzip git python3
curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp
/tmp/aws/install
# Ubuntu's official AMI includes the SSM agent as a snap.
snap start amazon-ssm-agent
curl -fsSL https://get.k3s.io -o /tmp/install-k3s.sh
INSTALL_K3S_VERSION='${k3s_version}' sh /tmp/install-k3s.sh --secrets-encryption --write-kubeconfig-mode=600
